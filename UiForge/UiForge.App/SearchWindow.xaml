<Window x:Class="UiForge.App.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поиск по всем файлам интерфейса" Width="780" Height="620" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#15161C" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#1B1C24"/>
        <SolidColorBrush x:Key="PanelBgAlt" Color="#20212B"/>
        <SolidColorBrush x:Key="BorderBrush1" Color="#2B2C38"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E7E7EE"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8E8FA3"/>
        <SolidColorBrush x:Key="Accent" Color="#7C6FF0"/>
        <SolidColorBrush x:Key="AccentLight" Color="#B4ACFF"/>
        <SolidColorBrush x:Key="SelectionBg" Color="#332F55"/>

        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/></Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelBgAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectionBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <TextBox x:Name="QueryBox" DockPanel.Dock="Top" FontSize="16" TextChanged="QueryBox_TextChanged"
                 ToolTip="Что искать: имя файла или элемента, текст надписи, путь к картинке, команда… (китайский тоже)"/>

        <WrapPanel DockPanel.Dock="Top" Margin="0,10,0,8">
            <CheckBox x:Name="CatFiles" Content="Имена файлов" IsChecked="True" Click="Filter_Click"/>
            <CheckBox x:Name="CatNames" Content="Имена элементов" IsChecked="True" Click="Filter_Click"/>
            <CheckBox x:Name="CatText" Content="Тексты и подсказки" IsChecked="True" Click="Filter_Click"/>
            <CheckBox x:Name="CatImages" Content="Картинки" IsChecked="True" Click="Filter_Click"/>
            <CheckBox x:Name="CatOther" Content="Остальное" IsChecked="True" Click="Filter_Click"/>
        </WrapPanel>

        <ProgressBar x:Name="Bar" DockPanel.Dock="Top" Height="3" Margin="0,0,0,6" Minimum="0" Maximum="1"
                     Foreground="{StaticResource Accent}" Background="{StaticResource BorderBrush1}" BorderThickness="0"/>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{StaticResource TextMuted}" FontSize="12"
                   Text="Двойной щелчок или Enter — открыть файл и выделить найденный элемент."/>

        <ListBox x:Name="ResultsList" MouseDoubleClick="ResultsList_MouseDoubleClick" KeyDown="ResultsList_KeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock>
                            <Run Text="{Binding File, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="  ›  " Foreground="{StaticResource TextMuted}"/>
                            <Run Text="{Binding ElementLabel, Mode=OneWay}" Foreground="{StaticResource AccentLight}"/>
                            <Run Text="{Binding AttrBadge, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="11.5"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Snippet, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
