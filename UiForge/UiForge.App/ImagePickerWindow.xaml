<Window x:Class="UiForge.App.ImagePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор картинки" Height="480" Width="480" MinHeight="300" MinWidth="320"
        Background="#15161C" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#1B1C24"/>
        <SolidColorBrush x:Key="BorderBrush1" Color="#2B2C38"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E7E7EE"/>
        <SolidColorBrush x:Key="Accent" Color="#7C6FF0"/>
        <SolidColorBrush x:Key="SelectionBg" Color="#332F55"/>

        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#20212B"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectionBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                 TextChanged="FilterBox_TextChanged"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Отмена" IsCancel="True"/>
            <Button Content="Выбрать" Click="ChooseButton_Click"/>
        </StackPanel>
        <ListBox x:Name="FilesList" MouseDoubleClick="FilesList_MouseDoubleClick"/>
    </DockPanel>
</Window>
