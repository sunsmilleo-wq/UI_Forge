<Window x:Class="UiForge.App.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор цвета" Width="372" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#15161C"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBgAlt" Color="#20212B"/>
        <SolidColorBrush x:Key="BorderBrush1" Color="#2B2C38"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E7E7EE"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8E8FA3"/>
        <SolidColorBrush x:Key="Accent" Color="#7C6FF0"/>
        <SolidColorBrush x:Key="AccentHover" Color="#9186F4"/>

        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelBgAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <!-- Квадрат насыщенность/яркость -->
        <Grid Width="300" Height="180" HorizontalAlignment="Left">
            <Border x:Name="SvBase" Background="Red" CornerRadius="4"/>
            <Border CornerRadius="4">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border CornerRadius="4">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#FF000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas x:Name="SvCanvas" Width="300" Height="180" Background="Transparent" Cursor="Cross"
                    MouseLeftButtonDown="Sv_Down" MouseMove="Sv_Move" MouseLeftButtonUp="Sv_Up">
                <Ellipse x:Name="SvMarker" Width="14" Height="14" Stroke="White" StrokeThickness="2" IsHitTestVisible="False">
                    <Ellipse.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="3" Color="Black"/></Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>

        <!-- Оттенок -->
        <Grid Width="300" Height="16" Margin="0,12,0,0" HorizontalAlignment="Left">
            <Border CornerRadius="4">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF0000" Offset="0"/>
                        <GradientStop Color="#FFFF00" Offset="0.1667"/>
                        <GradientStop Color="#00FF00" Offset="0.3333"/>
                        <GradientStop Color="#00FFFF" Offset="0.5"/>
                        <GradientStop Color="#0000FF" Offset="0.6667"/>
                        <GradientStop Color="#FF00FF" Offset="0.8333"/>
                        <GradientStop Color="#FF0000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas x:Name="HueCanvas" Width="300" Height="16" Background="Transparent" Cursor="Hand"
                    MouseLeftButtonDown="Hue_Down" MouseMove="Hue_Move" MouseLeftButtonUp="Hue_Up">
                <Rectangle x:Name="HueMarker" Width="4" Height="16" Fill="White" Stroke="Black" StrokeThickness="1" IsHitTestVisible="False"/>
            </Canvas>
        </Grid>

        <!-- Прозрачность -->
        <DockPanel Margin="0,10,0,0" Width="300" HorizontalAlignment="Left">
            <TextBlock Text="Прозрачность" Foreground="{StaticResource TextMuted}" Width="92" VerticalAlignment="Center"/>
            <Slider x:Name="AlphaSlider" Minimum="0" Maximum="255" ValueChanged="AlphaSlider_ValueChanged" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Числа -->
        <Grid Margin="0,12,0,0" Width="300" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="R" Foreground="{StaticResource TextMuted}"/><TextBox x:Name="RBox" TextChanged="RgbaBox_TextChanged"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,6,0"><TextBlock Text="G" Foreground="{StaticResource TextMuted}"/><TextBox x:Name="GBox" TextChanged="RgbaBox_TextChanged"/></StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,6,0"><TextBlock Text="B" Foreground="{StaticResource TextMuted}"/><TextBox x:Name="BBox" TextChanged="RgbaBox_TextChanged"/></StackPanel>
            <StackPanel Grid.Column="3"><TextBlock Text="A" Foreground="{StaticResource TextMuted}"/><TextBox x:Name="ABox" TextChanged="RgbaBox_TextChanged"/></StackPanel>
        </Grid>

        <DockPanel Margin="0,10,0,0" Width="300" HorizontalAlignment="Left">
            <TextBlock Text="HEX  #" Foreground="{StaticResource TextMuted}" Width="50" VerticalAlignment="Center"/>
            <TextBox x:Name="HexBox" TextChanged="HexBox_TextChanged" MaxLength="6"/>
        </DockPanel>

        <!-- Было / стало -->
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Было" Foreground="{StaticResource TextMuted}" FontSize="11.5"/>
                <Border x:Name="OldBox" Width="120" Height="30" CornerRadius="4" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1">
                    <Border x:Name="OldInner" CornerRadius="3"/>
                </Border>
            </StackPanel>
            <StackPanel Margin="20,0,0,0">
                <TextBlock Text="Стало" Foreground="{StaticResource TextMuted}" FontSize="11.5"/>
                <Border x:Name="NewBox" Width="120" Height="30" CornerRadius="4" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1">
                    <Border x:Name="NewInner" CornerRadius="3"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Готовые цвета -->
        <TextBlock Text="Быстрый выбор" Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,14,0,4"/>
        <WrapPanel x:Name="Palette" Width="300" HorizontalAlignment="Left"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" IsCancel="True" Background="#2E2F3D"/>
            <Button Content="Готово" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
