<Window x:Class="UiForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="UiForge v1.2 — редактор интерфейсов Perfect World" Height="900" Width="1500"
        MinHeight="600" MinWidth="1100"
        Background="#15161C" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg"      Color="#1B1C24"/>
        <SolidColorBrush x:Key="PanelBgAlt"   Color="#20212B"/>
        <SolidColorBrush x:Key="BorderBrush1" Color="#2B2C38"/>
        <SolidColorBrush x:Key="TextPrimary"  Color="#E7E7EE"/>
        <SolidColorBrush x:Key="TextMuted"    Color="#8E8FA3"/>
        <SolidColorBrush x:Key="Accent"       Color="#7C6FF0"/>
        <SolidColorBrush x:Key="AccentHover"  Color="#9186F4"/>
        <SolidColorBrush x:Key="AccentDim"    Color="#3B3660"/>
        <SolidColorBrush x:Key="SelectionBg"  Color="#332F55"/>
        <SolidColorBrush x:Key="Good"         Color="#6FCF97"/>
        <SolidColorBrush x:Key="Warn"         Color="#F2C94C"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{StaticResource AccentDim}"/>
                                <Setter Property="Foreground" Value="#7A7A90"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2E2F3D"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelBgAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBgAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <DataTemplate x:Key="AddTypeItemTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="{Binding Tag}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="10,2,0,0"/>
            </StackPanel>
        </DataTemplate>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectionBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===== Тулбар ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1">
            <StackPanel Margin="12,10">
                <WrapPanel Margin="0,0,0,8">
                    <TextBlock Text="Интерфейсы:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <Button Content="Архив .pck…" Click="OpenInterfacePck_Click"/>
                    <Button Content="Папка…" Style="{StaticResource SecondaryButton}" Click="OpenInterfaceDir_Click"/>
                    <TextBlock x:Name="InterfaceLabel" Text="не выбраны" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" Margin="4,0,28,0"/>

                    <TextBlock Text="Текстуры:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <Button Content="Архив .pck…" Click="OpenTexturePck_Click"/>
                    <Button Content="Папка…" Style="{StaticResource SecondaryButton}" Click="OpenTextureDir_Click"/>
                    <TextBlock x:Name="TextureLabel" Text="не выбраны" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                </WrapPanel>
                <WrapPanel>
                    <Button x:Name="SaveButton" Content="Сохранить" Click="SaveButton_Click" IsEnabled="False"/>
                    <Button x:Name="ExportButton" Content="Экспорт XML…" Style="{StaticResource SecondaryButton}"
                            Click="ExportButton_Click" IsEnabled="False"/>
                    <Button x:Name="UndoButton" Content="Отменить" Style="{StaticResource SecondaryButton}"
                            Click="UndoButton_Click" IsEnabled="False" ToolTip="Ctrl+Z"/>
                    <Button x:Name="RedoButton" Content="Повторить" Style="{StaticResource SecondaryButton}"
                            Click="RedoButton_Click" IsEnabled="False" ToolTip="Ctrl+Y"/>

                    <Border Width="1" Margin="6,4,12,4" Background="{StaticResource BorderBrush1}"/>

                    <Button x:Name="AddButton" Content="＋ Добавить элемент ▾" Click="AddButton_Click" IsEnabled="False"/>
                    <Popup x:Name="AddPopup" PlacementTarget="{Binding ElementName=AddButton}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="#1B1C24" BorderBrush="#3B3C4C" BorderThickness="1" CornerRadius="8"
                                Padding="6" Margin="0,4,14,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.6" Color="Black"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Что добавить в окно?" Foreground="{StaticResource TextMuted}"
                                           FontSize="11.5" Margin="8,4,8,6"/>
                                <ListBox x:Name="AddTypeList" BorderThickness="0" Background="Transparent"
                                         MinWidth="240" MaxHeight="420" ItemTemplate="{StaticResource AddTypeItemTemplate}"
                                         SelectionChanged="AddTypeList_SelectionChanged"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button x:Name="DuplicateButton" Content="Дублировать" Style="{StaticResource SecondaryButton}"
                            Click="DuplicateButton_Click" IsEnabled="False" ToolTip="Ctrl+D"/>
                    <Button x:Name="DeleteButton" Content="Удалить" Style="{StaticResource SecondaryButton}"
                            Click="DeleteButton_Click" IsEnabled="False" ToolTip="Delete"/>

                    <Border Width="1" Margin="6,4,12,4" Background="{StaticResource BorderBrush1}"/>

                    <CheckBox x:Name="SnapToGridCheck" Content="Сетка 5px" IsChecked="True"/>
                    <CheckBox x:Name="SnapToNeighborsCheck" Content="Прилипать к соседям" IsChecked="True"/>
                    <TextBlock x:Name="ZoomLabel" Text="100%" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" ToolTip="Ctrl + колесо мыши — масштаб"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ===== Статус-бар ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Margin="12,7" Text="Откройте архив или папку с интерфейсами, чтобы начать."
                       Foreground="{StaticResource TextMuted}" FontSize="12.5"/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Файлы интерфейса ===== -->
            <DockPanel Grid.Column="0" Margin="10">
                <TextBlock DockPanel.Dock="Top" Text="XML-файлы интерфейса" FontWeight="Bold" Margin="0,0,0,6"/>
                <Button x:Name="SearchButton" DockPanel.Dock="Top" Content="🔍 Поиск по всем файлам  (Ctrl+F)"
                        Click="SearchButton_Click" Margin="0,0,0,8" HorizontalAlignment="Stretch" IsEnabled="False"/>
                <TextBox x:Name="FileFilterBox" DockPanel.Dock="Top" Margin="0,0,0,6"
                         TextChanged="FileFilterBox_TextChanged" ToolTip="Фильтр по имени файла"/>
                <ListBox x:Name="InterfaceFilesList" SelectionChanged="InterfaceFilesList_SelectionChanged"/>
            </DockPanel>

            <Border Grid.Column="1" Background="{StaticResource BorderBrush1}"/>

            <!-- ===== Центр: холст сверху, код снизу ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="180"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="270" MinHeight="90"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#2A2B33">
                    <DockPanel>
                        <Border x:Name="MissingImagesBanner" DockPanel.Dock="Bottom" Background="#3A2E1A"
                                BorderBrush="{StaticResource Warn}" BorderThickness="0,1,0,0"
                                Padding="10,6" Visibility="Collapsed">
                            <TextBlock x:Name="MissingImagesText" Foreground="{StaticResource Warn}"
                                       TextWrapping="Wrap" FontSize="12"/>
                        </Border>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="Canvas_PreviewMouseWheel">
                            <Border Margin="30" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Border.LayoutTransform>
                                    <ScaleTransform x:Name="ZoomScale" ScaleX="1" ScaleY="1"/>
                                </Border.LayoutTransform>
                                <Border x:Name="DialogBackdrop" Background="#4B4C5A">
                                    <Canvas x:Name="DesignCanvas" ClipToBounds="True" Background="Transparent"
                                            MouseLeftButtonDown="DesignCanvas_MouseLeftButtonDown"
                                            MouseMove="DesignCanvas_MouseMove"
                                            MouseLeftButtonUp="DesignCanvas_MouseLeftButtonUp"/>
                                </Border>
                            </Border>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush1}"/>

                <DockPanel Grid.Row="2" Background="{StaticResource PanelBg}">
                    <Border DockPanel.Dock="Top" Padding="12,6" Background="{StaticResource PanelBg}">
                        <DockPanel>
                            <TextBlock x:Name="CodeStatus" DockPanel.Dock="Right" Text="" FontSize="12"/>
                            <TextBlock Text="Код (XML)" FontWeight="Bold"/>
                            <TextBlock Text="  — выделенное на холсте подсвечивается здесь; правки в коде применяются сами"
                                       Foreground="{StaticResource TextMuted}" FontSize="12" Margin="4,1,0,0"/>
                        </DockPanel>
                    </Border>
                    <avalonEdit:TextEditor x:Name="XmlEditor"
                        Margin="8,0,8,8"
                        FontFamily="Cascadia Code, Consolas" FontSize="13.5"
                        ShowLineNumbers="True" WordWrap="False"
                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                        Background="{StaticResource PanelBgAlt}"
                        Foreground="{StaticResource TextPrimary}"/>
                </DockPanel>
            </Grid>

            <Border Grid.Column="3" Background="{StaticResource BorderBrush1}"/>

            <!-- ===== Справа: элементы и свойства ===== -->
            <DockPanel Grid.Column="4" Background="{StaticResource PanelBg}">
                <TextBlock DockPanel.Dock="Top" Text="Элементы окна" Margin="12,12,12,4" FontWeight="Bold"/>
                <ListBox x:Name="ElementsList" DockPanel.Dock="Top" Height="170" Margin="12,0,12,8"
                         SelectionMode="Extended" DisplayMemberPath="ListLabel"
                         SelectionChanged="ElementsList_SelectionChanged"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PropertiesPanel" Margin="12,0,12,14"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
